# Copy to .env for docker-compose.yml and fill in random values:
#   openssl rand -hex 32
SYNCWELL_SECRET=
SYNCWELL_ADMIN_TOKEN=
SYNCWELL_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Core server options (defaults shown).
# SYNCWELL_ADDR=:8080          # or HOST:PORT; PORT alone also works
# SYNCWELL_DATA=               # data directory; empty = in-memory
# SYNCWELL_INSECURE=false      # allow a public bind without credentials (loudly unsafe)
# SYNCWELL_SECRET_PREVIOUS=    # comma-separated old secrets accepted during rotation

# TLS (leave empty to terminate TLS at a proxy).
# SYNCWELL_TLS_CERT=
# SYNCWELL_TLS_KEY=

# Optional OIDC: accept provider-issued JWTs (room + capability claims).
# A missing/empty caps claim is a deny; a "*" room claim is admin-only.
# SYNCWELL_OIDC_ISSUER=https://idp.example
# SYNCWELL_OIDC_AUDIENCE=syncwell
# SYNCWELL_OIDC_JWKS=
# SYNCWELL_OIDC_ROOM_CLAIM=syncwell_room
# SYNCWELL_OIDC_CAPS_CLAIM=syncwell_caps
# SYNCWELL_OIDC_REFRESH=15m

# Admin/cluster/WS hardening (defaults shown).
# SYNCWELL_ADMIN_RATE=120            # admin requests/min per IP (negative = unlimited)
# SYNCWELL_ADMIN_BURST=30
# SYNCWELL_ADMIN_MAX_FAILURES=10
# SYNCWELL_ADMIN_LOCKOUT=5m
# SYNCWELL_ADMIN_ALLOWLIST=          # comma-separated CIDRs for /stats and /metrics
# SYNCWELL_CLUSTER_RATE=6000         # /cluster/event requests/min per IP
# SYNCWELL_CLUSTER_ALLOWLIST=        # comma-separated CIDRs for /cluster/event
# SYNCWELL_WS_RATE=300               # websocket upgrade attempts/min per IP
# SYNCWELL_TRUST_PROXY=false         # use X-Forwarded-For (only behind a trusted proxy)
# SYNCWELL_PROXY_HOPS=1              # trusted proxies; XFF is parsed right-to-left

# Clustering / placement.
# SYNCWELL_NODE_ID=local
# SYNCWELL_NODE_PEERS=
# SYNCWELL_CLUSTER_PEERS=            # comma-separated peer base URLs
# SYNCWELL_CLUSTER_PATH=/cluster/event
# SYNCWELL_ANTI_ENTROPY=30s         # full-state push interval when clustered (0 = disabled)

# Capacity / limits (defaults shown).
# SYNCWELL_MAX_CLIENTS=256           # per room (0 = unlimited)
# SYNCWELL_MAX_ROOM_ID_BYTES=0       # max room id bytes (0 = server default)
# SYNCWELL_MAX_KEY_BYTES=0           # max document key bytes (0 = server default)
# SYNCWELL_MAX_NODE_BYTES=0          # max client node id bytes (0 = server default)
# SYNCWELL_MAX_VALUE_BYTES=0         # max register JSON value bytes (0 = server default)
# SYNCWELL_MAX_PRESENCE_BYTES=0      # max presence JSON value bytes (0 = server default)
# SYNCWELL_MAX_ROOMS=10000           # live rooms (0 = unlimited)
# SYNCWELL_MAX_MESSAGES_PER_SECOND=120
# SYNCWELL_MAX_MESSAGE_BYTES=1048576
# SYNCWELL_MAX_STATE_ENTRIES=        # per-room state cap (0 = default)
# SYNCWELL_IDLE_ROOM_TTL=60s         # negative = disabled

# Optional OTLP/HTTP tracing (off unless the endpoint is set).
# SYNCWELL_OTEL_ENDPOINT=http://otel-collector:4318
# SYNCWELL_OTEL_INSECURE=false
# SYNCWELL_OTEL_HEADERS=             # comma-separated key=value headers
# SYNCWELL_OTEL_SAMPLE_RATE=0.1
# SYNCWELL_OTEL_SERVICE_NAME=syncwell

# Optional room-milestone webhooks (v1 timestamped HMAC-SHA256 when a secret is set).
# SYNCWELL_WEBHOOK_URLS=https://hooks.example.com/syncwell
# SYNCWELL_WEBHOOK_SECRET=
# SYNCWELL_WEBHOOK_TIMEOUT=5s
# SYNCWELL_WEBHOOK_QUEUE=256

# Serving (defaults shown; both skipped if the directory is missing).
# SYNCWELL_STATIC=examples/demos       # static files served at /
# SYNCWELL_SDK=clients/javascript    # client SDK served at /sdk/

# Durability (defaults shown).
SYNCWELL_FSYNC=batch                # os | batch | every
# SYNCWELL_FSYNC_INTERVAL=5ms
SYNCWELL_MAX_LOG_BYTES=67108864
# SYNCWELL_COMPACT=256               # winning writes between maintenance passes (GC + compaction)

# Emergency token revocation (space/comma-separated JWT IDs).
# SYNCWELL_REVOKED_JTIS=
