# Credentials for /etc/syncwell.env (mode 0600). Do not commit the real file.
# Generate values with: openssl rand -hex 32
SYNCWELL_SECRET=replace-with-a-32-byte-random-secret
SYNCWELL_ADMIN_TOKEN=replace-with-a-separate-32-byte-random-token

# Required: exact browser origins. The unit sets -require-origins, so startup
# fails closed until this matches the public site (scheme://host[:port]).
SYNCWELL_ORIGINS=https://sync.example.com

# Optional OIDC (takes precedence for external identity providers):
# SYNCWELL_OIDC_ISSUER=https://idp.example.com
# SYNCWELL_OIDC_AUDIENCE=syncwell
# SYNCWELL_OIDC_ROOM_CLAIM=syncwell_room
# SYNCWELL_OIDC_CAPS_CLAIM=syncwell_caps

# Restrict operational endpoints further if they are not needed remotely:
# SYNCWELL_ADMIN_ALLOWLIST=10.0.0.0/8
