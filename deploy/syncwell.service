# systemd unit for a self-hosted binary install.
#   sudo install -m 0755 syncwell /usr/local/bin/syncwell
#   sudo install -d -o syncwell -g syncwell /var/lib/syncwell
#   sudo install -d /usr/share/syncwell && sudo cp -r demo sdk /usr/share/syncwell/
#   sudo cp deploy/syncwell.service /etc/systemd/system/
#   sudo systemctl enable --now syncwell
[Unit]
Description=Syncwell real-time collaboration engine
Documentation=https://github.com/Nil-Vaghani/syncwell
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=syncwell
Group=syncwell
EnvironmentFile=-/etc/syncwell.env
ExecStart=/usr/local/bin/syncwell \
  -addr 127.0.0.1:8080 \
  -data /var/lib/syncwell \
  -static /usr/share/syncwell/demo \
  -sdk /usr/share/syncwell/sdk
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/syncwell

[Install]
WantedBy=multi-user.target
