{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping Syncwell /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Rooms",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(syncwell_rooms)", "legendFormat": "rooms", "range": true, "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Connected clients",
      "gridPos": { "h": 5, "w": 5, "x": 4, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5000 }, { "color": "red", "value": 10000 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(syncwell_clients_total)", "legendFormat": "clients", "range": true, "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Live registers",
      "gridPos": { "h": 5, "w": 5, "x": 9, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(syncwell_live_registers_total)", "legendFormat": "live", "range": true, "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Tombstones",
      "gridPos": { "h": 5, "w": 6, "x": 14, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(syncwell_tombstones_total)", "legendFormat": "tombstones", "range": true, "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Apply latency (ms)",
      "description": "Server-side merge + persist time for one register.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.50, sum(rate(syncwell_apply_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p50", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum(rate(syncwell_apply_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "histogram_quantile(0.99, sum(rate(syncwell_apply_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p99", "range": true, "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Message rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(syncwell_inbound_frame_bytes_count[1m]))", "legendFormat": "inbound frames", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(syncwell_outbound_frame_bytes_count[1m]))", "legendFormat": "outbound frames", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "sum(rate(syncwell_apply_duration_seconds_count[1m]))", "legendFormat": "applies", "range": true, "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Frame size p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum(rate(syncwell_inbound_frame_bytes_bucket[5m])) by (le))", "legendFormat": "inbound", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum(rate(syncwell_outbound_frame_bytes_bucket[5m])) by (le))", "legendFormat": "outbound", "range": true, "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cluster relay",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(syncwell_cluster_relay_posts_total[5m]))", "legendFormat": "posts/s", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(syncwell_cluster_relay_errors_total[5m]))", "legendFormat": "errors/s", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "sum(rate(syncwell_cluster_relay_dropped_total[5m]))", "legendFormat": "drops/s", "range": true, "refId": "C" },
        { "editorMode": "code", "expr": "sum(syncwell_cluster_relay_inflight)", "legendFormat": "inflight", "range": true, "refId": "D" }
      ]
    },
    {
      "type": "table",
      "title": "Peers",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [{ "matcher": { "id": "byName", "options": "up" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }] }] }] },
      "options": { "showHeader": true },
      "targets": [{ "editorMode": "code", "expr": "syncwell_cluster_peer_up", "format": "table", "instant": true, "range": false, "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Room clients (top 10)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "topk(10, syncwell_room_clients)", "legendFormat": "{{room}}", "range": true, "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "GC low-water (top 10 rooms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "topk(10, syncwell_room_low_water)", "legendFormat": "{{room}}", "range": true, "refId": "A" }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["syncwell", "realtime", "crdt"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Syncwell",
  "uid": "syncwell-overview",
  "version": 1,
  "weekStart": ""
}
