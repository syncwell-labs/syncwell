{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["*.d.ts", "types.check.ts"]
}
